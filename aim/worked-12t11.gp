G[21] = Polrev([25089798804264/1010521154671,71260535053854/1010521154671,-59007768100808/1010521154671,-167482660055057/1010521154671,675694987805/59442420863,72833885342528/1010521154671,421692445247/144360164953,-10535369292296/1010521154671,-583402316769/1010521154671,590038226726/1010521154671,20695987332/1010521154671,-11272787545/1010521154671], x);

G[19] = Polrev([-279484502447/43935702377,-2939716092045/43935702377,-698416268420/43935702377,5656777728708/43935702377,1003039850636/43935702377,-2277262539668/43935702377,-1068632875/153086071,323658997456/43935702377,30828627898/43935702377,-18316218418/43935702377,-895591233/43935702377,357819906/43935702377], x);
